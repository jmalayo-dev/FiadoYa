    {
      "name": "HU04 Venta al contado",
      "item": [
        {
          "name": "Contado 2 ítems → 201 CONFIRMADA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{clave}}"
              }
            ],
            "url": "{{baseUrl}}/api/ventas",
            "body": {
              "mode": "raw",
              "raw": "{\"clienteId\": null, \"tipoPago\": \"CONTADO\", \"items\": [{\"productoId\": \"{{prodA}}\", \"cantidad\": 2}, {\"productoId\": \"{{prodB}}\", \"cantidad\": 1}]}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('clave', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const v = pm.response.json();",
                  "pm.test('CONFIRMADA y total HALF_UP', () => { pm.expect(v.estado).to.eql('CONFIRMADA'); pm.expect(v.total).to.eql(11.25); });",
                  "pm.collectionVariables.set('ventaContado', v.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Misma Idempotency-Key → misma venta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{clave}}"
              }
            ],
            "url": "{{baseUrl}}/api/ventas",
            "body": {
              "mode": "raw",
              "raw": "{\"clienteId\": null, \"tipoPago\": \"CONTADO\", \"items\": [{\"productoId\": \"{{prodA}}\", \"cantidad\": 2}, {\"productoId\": \"{{prodB}}\", \"cantidad\": 1}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('mismo id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('ventaContado')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stock restado una sola vez",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/productos/{{prodA}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('stock 28', () => pm.expect(pm.response.json().stock).to.eql(28));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stock insuficiente en el 2.º ítem → 409 sin descontar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{clave}}"
              }
            ],
            "url": "{{baseUrl}}/api/ventas",
            "body": {
              "mode": "raw",
              "raw": "{\"clienteId\": null, \"tipoPago\": \"CONTADO\", \"items\": [{\"productoId\": \"{{prodA}}\", \"cantidad\": 1}, {\"productoId\": \"{{prodB}}\", \"cantidad\": 5}]}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('clave', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('code PRODUCTO_STOCK_INSUFICIENTE', () => pm.expect(pm.response.json().code).to.eql('PRODUCTO_STOCK_INSUFICIENTE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ningún ítem descontado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/productos/{{prodA}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('stock sigue en 28', () => pm.expect(pm.response.json().stock).to.eql(28));"
                ]
              }
            }
          ]
        },
